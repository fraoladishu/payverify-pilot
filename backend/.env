# ===================================================
# PayVerify Environment Configuration
# ===================================================

PORT=5000
NODE_ENV=development

# JWT Secret for Staff Authentication
JWT_SECRET=payverify_super_secret_jwt_key_2025

# Database Configuration (sqlite | mysql | json)
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=payverify_db

# ===================================================
# 1. CHAPA PAYMENT GATEWAY CONFIGURATION
# ===================================================
# Register / Login at https://dashboard.chapa.co
# Get your API keys under Settings -> API & Webhooks
# For Test Mode: Use 'CHASECK_TEST-xxxxxxxx'
# For Live Mode: Use 'CHASECK-xxxxxxxx'
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here
CHAPA_API_URL=https://api.chapa.co/v1

# ===================================================
# 2. SANTIMPAY GATEWAY CONFIGURATION
# ===================================================
# Register / Login at https://santimpay.com (or testnet)
# Merchant ID and Private Key from your SantimPay merchant portal
SANTIM_MERCHANT_ID=your_santimpay_merchant_id
SANTIM_PRIVATE_KEY=your_santimpay_private_key_or_token
SANTIM_API_URL=https://services.santimpay.com/api/v1/gateway
# For Testnet: https://testnet.santimpay.com/api/v1/gateway

# ===================================================
# BASE URL FOR WEBHOOKS (Use ngrok or domain in development)
# Example: https://your-subdomain.ngrok-free.app
# ===================================================
APP_BASE_URL=http://localhost:5000

# Security Configuration
ENABLE_GATEWAY_WEBHOOKS=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173

